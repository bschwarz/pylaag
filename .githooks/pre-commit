#!/bin/sh
# Pre-commit hook for pylaag project
# Runs ruff linting, formatting, and tests before allowing commit
#
# To install this hook, run:
#   cp .githooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or configure git to use this hooks directory:
#   git config core.hooksPath .githooks

set -e

echo "🔍 Running pre-commit checks..."

# Run ruff check with auto-fix
echo "\n📋 Running ruff check --fix..."
if ! uv run ruff check --fix; then
    echo "❌ Ruff check failed. Please fix the issues and try again."
    exit 1
fi

# Run ruff format
echo "\n🎨 Running ruff format..."
if ! uv run ruff format; then
    echo "❌ Ruff format failed. Please fix the issues and try again."
    exit 1
fi

# Run mypy type checking
echo "\n🔎 Running mypy type checking..."
if ! uv run mypy packages; then
    echo "❌ Mypy type checking failed. Please fix the type errors and try again."
    exit 1
fi

# Run pytest (only on packages that have been modified)
echo "\n🧪 Running pytest on modified packages..."
# Get list of modified Python files
MODIFIED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.py$' || true)

if [ -n "$MODIFIED_FILES" ]; then
    # Extract unique package names from modified files
    PACKAGES=$(echo "$MODIFIED_FILES" | grep '^packages/' | cut -d'/' -f1-2 | sort -u || true)
    
    if [ -n "$PACKAGES" ]; then
        for PACKAGE in $PACKAGES; do
            echo "  Testing $PACKAGE..."
            if ! uv run pytest "$PACKAGE/tests" -q; then
                echo "❌ Tests failed in $PACKAGE. Please fix the failing tests and try again."
                exit 1
            fi
        done
    else
        echo "  No package tests to run (modified files outside packages/)"
    fi
else
    echo "  No Python files modified, skipping tests"
fi

echo "\n✅ All pre-commit checks passed!"
exit 0
